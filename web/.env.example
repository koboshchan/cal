# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB. In docker-compose this is set to mongodb://mongo:27017/cal
# (Docker DNS, no auth, no published port). Only override for local-non-docker dev.
MONGODB_URI=mongodb://localhost:27017/cal

# The LLM provider (OpenAI-compatible base URL / API key / model) is NOT
# configured here — it's set at runtime by the first (admin) user via the
# /admin page and stored in MongoDB, so it can be changed without a redeploy.
